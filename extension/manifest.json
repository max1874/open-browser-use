{
  "manifest_version": 3,
  "name": "Open Browser Use",
  "version": "0.1.0",
  "description": "Groups each agent session's tabs, shows the agent's pointer on the tab it drives, and keeps tabs left for you open.",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage"
  ],
  "background": {
    "service_worker": "bh_session_groups_sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bh_active_tab.js"
      ],
      "run_at": "document_start"
    }
  ]
}
