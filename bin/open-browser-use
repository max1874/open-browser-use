#!/bin/sh
# open-browser-use — the agent Chrome. Installed as a symlink by ../install.sh.
#
#   open-browser-use [start]            start it unless it is running (the wrapper does this)
#   open-browser-use restart [--force]  quit and relaunch it
#   open-browser-use window PROFILE     open a window of a Chrome profile (agent_helpers.py does this)
#   open-browser-use reap               clean up after ended sessions (../libexec/reap.py)
#
# PROFILE is a name from Chrome's profile menu ("Work"). A cold start opens the
# one in OBU_PROFILE, set by the wrapper (docs/profiles.md), else the last used.
#
# One long-lived Chrome with its own data directory, listening on a fixed CDP
# port. All agent sessions share it, so logins persist across sessions and the
# user's everyday Chrome is never touched. OBU_CHROME_APP names another
# Chromium-family app; only Google Chrome has been tested.
#
# Launched with `open -g` and no window (ensure_window below) so starting it
# never steals focus from whatever the user is doing. A non-default
# user-data-dir also sidesteps Chrome 144's per-connection "Allow remote
# debugging?" sheet (see daemon.py:216-219).
#
# The extension (one tab group per agent session, the pointer, tab marks) is
# installed once per profile with chrome://extensions → "Load unpacked", which
# Chrome keeps across restarts (Chrome 156, 2026-11-04). It cannot be installed
# from here: branded Chrome ignores --load-extension, and a CDP-loaded extension
# is gone at the next launch.

PORT="${OBU_PORT:-9333}"
DATA="${OBU_CHROME_DATA:-$HOME/.local/share/open-browser-use/chrome}"
ENDPOINT="http://127.0.0.1:$PORT/json/version"
REPO="$(dirname "$(dirname "$(realpath "$0")")")"
EXTENSION="${OBU_EXTENSION:-$REPO/extension}"
BH_PY="$HOME/.local/share/uv/tools/browser-harness/bin/python3"

usage() { echo "usage: open-browser-use [start | restart [--force] | window PROFILE | reap]" >&2; exit 2; }
case "${1:-start}" in
  start|restart) ;;
  window) [ -n "${2:-}" ] || usage ;;
  reap) [ -x "$BH_PY" ] || exit 0; exec "$BH_PY" -I "$REPO/libexec/reap.py" ;;
  *) usage ;;
esac

# One launcher at a time: a supervisor that relaunches Chrome as soon as it
# exits would otherwise race a restart into two cold starts.
if [ -z "${OBU_LOCKED:-}" ]; then
  mkdir -p "$DATA"
  export OBU_LOCKED=1
  exec lockf -k "$DATA/.launch.lock" "$0" "$@"
fi

alive() { curl -sf -m 1 "$ENDPOINT" >/dev/null 2>&1; }

# A Chrome without a window takes the front when it opens one, despite `open -g`
# at launch, and for the first tab CDP opens later (Chrome 157, 2026-11-11). The
# extension's windows.create({focused: false}) does not, so a cold start opens
# no window and this opens the first one, before any daemon asks CDP for a tab.
# TRIES tenths of a second to wait for the extension's worker; without one the
# daemon's first tab still raises Chrome.
ensure_window() {
  curl -sf -m 1 "http://127.0.0.1:$PORT/json/list" | grep -q '"type": "page"' && return
  "$BH_PY" -I - "$ENDPOINT" "$1" <<'PY' || echo "open-browser-use: no extension to open a window in the background; Chrome may come to the front" >&2
import asyncio, json, sys, urllib.request, websockets

async def main(endpoint, tries):
    async with websockets.connect(json.load(urllib.request.urlopen(endpoint))["webSocketDebuggerUrl"]) as ws:
        async def cdp(method, session=None, **params):
            msg = {"id": cdp.n, "method": method, "params": params, **({"sessionId": session} if session else {})}
            cdp.n += 1
            await ws.send(json.dumps(msg))
            while (r := json.loads(await ws.recv())).get("id") != msg["id"]:
                pass
            return r["result"]
        cdp.n = 1
        for _ in range(tries):
            infos = (await cdp("Target.getTargets"))["targetInfos"]
            sw = next((t for t in infos if t["type"] == "service_worker" and t["url"].endswith("/bh_session_groups_sw.js")), None)
            if sw:
                session = (await cdp("Target.attachToTarget", targetId=sw["targetId"], flatten=True))["sessionId"]
                await cdp("Runtime.evaluate", session, expression="chrome.windows.create({focused: false})", awaitPromise=True)
                return
            await asyncio.sleep(0.1)
        sys.exit(1)

asyncio.run(main(sys.argv[1], int(sys.argv[2])))
PY
}

# The directory of the Chrome profile with this name; without one, the last used.
profile_dir() {
  python3 -I - "$DATA/Local State" "${1:-}" <<'PY'
import json, sys

try:
    profiles = json.load(open(sys.argv[1]))["profile"]
except (OSError, KeyError, ValueError):
    profiles = {}  # a new data directory
cache, name = profiles.get("info_cache", {}), sys.argv[2]
dirs = [d for d, p in cache.items() if p.get("name", "").lower() == name.lower()]
if name and not dirs:
    sys.exit(f'open-browser-use: there is no Chrome profile named "{name}"; there are: '
             + ", ".join(p.get("name", d) for d, p in cache.items()))
print(dirs[0] if name else profiles.get("last_used", "Default"))
PY
}

# window PROFILE: on a running Chrome, which then comes to the front: neither
# `open -g` nor any launch flag keeps it back (Chrome 156, 2026-11-05).
if [ "$1" = "window" ]; then
  alive || { echo "open-browser-use: the agent Chrome is not running" >&2; exit 1; }
  dir=$(profile_dir "$2") || exit 1
  # Without the extension the window is of no use to agent_helpers.py, and
  # every retry would raise Chrome again.
  python3 -I - "$DATA/$dir/Secure Preferences" "$EXTENSION" 2>/dev/null <<'PY' || { echo "open-browser-use: the extension is not installed in the Chrome profile \"$2\".
  Once, in that profile: chrome://extensions → Developer mode → Load unpacked → $EXTENSION" >&2; exit 1; }
import json, os, sys

settings = json.load(open(sys.argv[1]))["extensions"]["settings"].values()
sys.exit(not any(os.path.realpath(s.get("path", "")) == os.path.realpath(sys.argv[2]) for s in settings))
PY
  exec open -g -n -a "${OBU_CHROME_APP:-Google Chrome}" --args --user-data-dir="$DATA" --profile-directory="$dir"
fi

# restart [--force]: e.g. to pick up launch flags. Every agent session shares
# this browser, so closing it closes their tabs mid-task (2026-10-10 a restart
# closed another session's login page the user was about to use). Refuse while
# another session's daemon is alive; --force is for when the user has said it
# is fine.
if [ "${1:-}" = "restart" ]; then
  self=""
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then self="cc-${CLAUDE_CODE_SESSION_ID%%-*}"
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then self="cx-${CODEX_THREAD_ID%%-*}"; fi
  self="${BU_NAME:-$self}"
  others=""
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/browser-harness/runtime/bu-*.pid; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .pid); name=${name#bu-}
    [ "$name" = "$self" ] && continue
    pid=$(cat "$f" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && others="$others $name"
  done
  if [ -n "$others" ] && [ "${2:-}" != "--force" ]; then
    echo "open-browser-use: not restarting — other sessions have live daemons:$others" >&2
    echo "  Closing Chrome would close their tabs. Ask the user, then use restart --force." >&2
    exit 2
  fi
  if alive; then
    "$BH_PY" -I - "$ENDPOINT" <<'PY'
import asyncio, json, sys, urllib.request, websockets

async def main(endpoint):
    ws_url = json.load(urllib.request.urlopen(endpoint))["webSocketDebuggerUrl"]
    async with websockets.connect(ws_url) as ws:
        await ws.send(json.dumps({"id": 1, "method": "Browser.close"}))
        try:
            await asyncio.wait_for(ws.recv(), 5)
        except Exception:
            pass

asyncio.run(main(sys.argv[1]))
PY
    i=0
    while pgrep -f "user-data-dir=$DATA" >/dev/null && [ "$i" -lt 40 ]; do sleep 0.5; i=$((i + 1)); done
  fi
fi

# The user may have closed every window; Chrome keeps running without one.
alive && { ensure_window 1; exit 0; }

# Which profile to open: the session's, else the last used, so a profile the
# user switched to (2026-10-11: Default deleted, signed in as Profile 2) keeps
# working. Naming it on the command line also skips the profile picker Chrome
# shows at launch once there are several profiles; it opens no other profile,
# whatever Local State lists as last active (2026-11-05).
PROFILE="${OBU_CHROME_PROFILE:-$(profile_dir "${OBU_PROFILE:-}" || profile_dir)}"

# For every profile, while Chrome is down (it rewrites these files on exit):
# vertical tabs and no saved-groups bar in Preferences, and a word if the
# extension is missing, which Chrome records by folder in Secure Preferences.
mkdir -p "$DATA/$PROFILE"
python3 -I - "$DATA" "$PROFILE" "$EXTENSION" <<'PY' || echo "open-browser-use: could not set profile prefs" >&2
import json, os, sys

data, launched, extension = sys.argv[1:]
WANT = {
    ("vertical_tabs", "enabled"): True,
    ("bookmark_bar", "show_tab_groups"): False,
}
try:
    names = {d: p.get("name", d) for d, p in json.load(open(f"{data}/Local State"))["profile"]["info_cache"].items()}
except (OSError, KeyError, ValueError):
    names = {}
names.setdefault(launched, launched)
for d, name in names.items():
    path = f"{data}/{d}/Preferences"
    prefs = json.load(open(path)) if os.path.exists(path) else {}
    changed = False
    for keys, value in WANT.items():
        node = prefs
        for k in keys[:-1]:
            node = node.setdefault(k, {})
        if node.get(keys[-1]) != value:
            node[keys[-1]] = value
            changed = True
    if changed:
        json.dump(prefs, open(path, "w"), separators=(",", ":"))
    try:
        settings = json.load(open(f"{data}/{d}/Secure Preferences"))["extensions"]["settings"].values()
    except (OSError, KeyError, ValueError):
        settings = []
    if not any(os.path.realpath(s.get("path", "")) == os.path.realpath(extension) for s in settings):
        print(f'open-browser-use: the extension is not installed in the Chrome profile "{name}".\n'
              f"  Once, in that profile: chrome://extensions → Developer mode → Load unpacked → {extension}", file=sys.stderr)
PY

open -g -n -a "${OBU_CHROME_APP:-Google Chrome}" --args \
  --user-data-dir="$DATA" \
  --profile-directory="$PROFILE" \
  --remote-debugging-port="$PORT" \
  --no-first-run \
  --no-default-browser-check \
  --disable-features=ChromeWhatsNewUI \
  --no-startup-window

i=0
while [ "$i" -lt 60 ]; do
  alive && { ensure_window 50; exit 0; }
  sleep 0.5
  i=$((i + 1))
done

echo "open-browser-use: no CDP endpoint on port $PORT after 30s (data: $DATA)" >&2
exit 1
