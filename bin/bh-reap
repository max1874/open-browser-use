#!/bin/sh
# bh-reap — clean up after agent sessions that have ended: stop their
# browser-harness daemons and close their tab groups in the agent Chrome.
# Run in the background by ./browser-harness (at most every 10 minutes); safe
# to run by hand.
#
# One daemon per session (BU_NAME = cc-<id>/cx-<id>, see ./browser-harness),
# and nothing stops them when the session ends: 2026-10-12 there were 13, the
# oldest a day old, each holding a CDP connection and a background tab in the
# agent Chrome. Session end is read from the agents' own records, two signals
# for Claude Code so neither alone can stop a live session's daemon:
#
#   cc-<id>  no running claude process has this session (~/.claude/sessions/
#            <pid>.json) and its transcript is untouched for an hour
#   cx-<id>  its Codex rollout is untouched for a day
#   other    (BU_NAME set by hand, "default") started over a day ago, or no
#            daemon left
#
# A daemon stopped by mistake costs little: the next browser-harness call in
# that session starts a new one. Stopping goes through browser-harness's own
# shutdown (admin.restart_daemon), which closes the daemon's background tab
# and stops a cloud browser if it holds one.
#
# Tab groups: agents are asked to call close_session() when done, but only
# some do, and the tabs it keeps for the user (mark_tab) were never closed:
# 2026-10-13 the agent Chrome held groups of sessions ended 16 hours before.
# So an ended session's group is closed here too (session-groups extension,
# bhReapSession), unmarked tabs at once and marked ones a day after the end.
# Tabs outside our groups (Codex's own @Chrome groups, ungrouped tabs) have no
# owner to read and are left alone.

BH_PY="$HOME/.local/share/uv/tools/browser-harness/bin/python3"
[ -x "$BH_PY" ] || exit 0
exec "$BH_PY" -I - <<'PY'
import glob, json, os, sys, time, urllib.request
from browser_harness import _ipc as ipc
from browser_harness.admin import restart_daemon

HOME = os.path.expanduser("~")
HOUR, DAY = 3600, 86400
END = {"cc": HOUR, "cx": DAY}  # idle time after which a session counts as ended
now = time.time()


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, OverflowError):
        return False


def newest(pattern):
    return max((os.path.getmtime(p) for p in glob.glob(pattern)), default=0)


live_claude = set()
for f in glob.glob(f"{HOME}/.claude/sessions/*.json"):
    try:
        pid = int(os.path.basename(f)[:-5])
        sid = json.load(open(f)).get("sessionId") or ""
    except (ValueError, OSError, json.JSONDecodeError):
        continue
    if sid and alive(pid):
        live_claude.add(sid.split("-")[0])


def idle(name, started):
    """Seconds since the session was last active; None while it is running."""
    kind, _, sid = name.partition("-")
    if kind == "cc" and sid:
        return None if sid in live_claude else now - newest(f"{HOME}/.claude/projects/*/{sid}*.jsonl")
    if kind == "cx" and sid:
        return now - newest(f"{HOME}/.codex/sessions/*/*/*/rollout-*-{sid}*.jsonl")
    return now - started if started is not None else float("inf")


def ended(name, started, grace=0):
    age = idle(name, started)
    return age is not None and age > END.get(name.split("-")[0], DAY) + grace


def started_at(name):
    try:
        return os.path.getmtime(ipc._RUNTIME / f"bu-{name}.pid")
    except OSError:
        return None


me = os.environ.get("BU_NAME")

for pid_file in sorted(glob.glob(str(ipc._RUNTIME / "bu-*.pid"))):
    name = os.path.basename(pid_file)[len("bu-"):-len(".pid")]
    if name == me:
        continue
    try:
        pid = int(open(pid_file).read().strip())
        started = os.path.getmtime(pid_file)
    except (ValueError, OSError):
        continue
    if alive(pid) and not ended(name, started):
        continue
    try:
        restart_daemon(name)  # also clears the endpoint and pid file of a dead one
    except Exception as e:
        print(f"bh-reap: {name}: {e}", file=sys.stderr)
        continue
    print(f"bh-reap: {name}: " + ("still running" if alive(pid) else "stopped"))

# Daemon logs: one per name ever used, never removed (170 on 2026-10-12).
for log in glob.glob(str(ipc._TMP / "bu-*.log")):
    name = os.path.basename(log)[len("bu-"):-len(".log")]
    if not os.path.exists(ipc._RUNTIME / f"bu-{name}.pid") and now - os.path.getmtime(log) > 7 * DAY:
        os.unlink(log)


# --- tab groups of ended sessions ---------------------------------------------
# Talks CDP to the agent Chrome directly (no daemon); never launches Chrome.
SW = "/bh_session_groups_sw.js"


def reap_groups():
    port = os.environ.get("BH_AGENT_CHROME_PORT", "9333")
    try:
        ws_url = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=2))["webSocketDebuggerUrl"]
    except Exception:
        return  # agent Chrome not running
    from websockets.sync.client import connect

    with connect(ws_url, max_size=None, open_timeout=5) as ws:
        ids = iter(range(1, 1 << 30))

        def cdp(method, session=None, **params):
            i = next(ids)
            ws.send(json.dumps({"id": i, "method": method, "params": params, **({"sessionId": session} if session else {})}))
            while True:
                msg = json.loads(ws.recv(timeout=10))
                if msg.get("id") == i:
                    if "error" in msg:
                        raise RuntimeError(f"{method}: {msg['error']}")
                    return msg["result"]

        def worker():
            infos = cdp("Target.getTargets")["targetInfos"]
            return next((t for t in infos if t["type"] == "service_worker" and t["url"].endswith(SW)), None)

        sw = worker()
        if not sw:  # asleep: opening a tab wakes it (tabs.onCreated)
            waker = cdp("Target.createTarget", url="about:blank", background=True)["targetId"]
            try:
                for _ in range(20):
                    time.sleep(0.1)
                    sw = worker()
                    if sw:
                        break
            finally:
                cdp("Target.closeTarget", targetId=waker)
        if not sw:
            print("bh-reap: groups: session-groups extension not found", file=sys.stderr)
            return
        session = cdp("Target.attachToTarget", targetId=sw["targetId"], flatten=True)["sessionId"]

        def ev(expr):
            r = cdp("Runtime.evaluate", session, expression=expr, awaitPromise=True, returnByValue=True)
            if "exceptionDetails" in r:
                raise RuntimeError(r["exceptionDetails"].get("text"))
            return r["result"].get("value")

        try:
            for key in ev("bhSessionKeys()") or []:
                if key == me:
                    continue
                started = started_at(key)
                if not ended(key, started):
                    continue
                r = ev(f"bhReapSession({json.dumps(key)}, {json.dumps(ended(key, started, DAY))})")
                if r and r.get("closed"):
                    print(f"bh-reap: {key}: closed {r['closed']} tab(s), kept {r['kept']}")
        finally:
            cdp("Target.detachFromTarget", sessionId=session)


try:
    reap_groups()
except Exception as e:
    print(f"bh-reap: groups: {e}", file=sys.stderr)
PY
